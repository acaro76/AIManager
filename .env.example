OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
LMSTUDIO_ENDPOINT=http://localhost:1234/v1
LMSTUDIO_DEFAULT_MODEL=
LMSTUDIO_FAST_MODEL=
LMSTUDIO_CODE_MODEL=
LMSTUDIO_VISION_MODEL=
# Modello di embedding locale per il recupero mirato dei documenti residenti grandi
# (pin locale). Consigliato multilingua, es. bge-m3. Vuoto = ripiego sui primi pezzi
# del documento (niente overflow, ma senza selezione semantica).
LMSTUDIO_EMBED_MODEL=
# Cerebras: provider OpenAI-compatible; verifica modelli, limiti e condizioni sul sito ufficiale.
CEREBRAS_API_KEY=
CEREBRAS_DEFAULT_MODEL=gpt-oss-120b
# DeepSeek API ufficiale. Modelli, prezzi e disponibilita' possono cambiare: verifica il catalogo
# del provider prima dell'attivazione.
DEEPSEEK_API_KEY=
DEEPSEEK_DEFAULT_MODEL=deepseek-v4-flash
# Web search grounding: riduce le allucinazioni ancorando le risposte a fonti reali.
# WEB_SEARCH_PROVIDER: tavily
WEB_SEARCH_ENABLED=1
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT=8
TAVILY_API_KEY=

# Classificatore AI della ricerca web (Ipotesi B): decide se serve il web e con quale
# query, indipendente dalla lingua. WEB_INTENT_PROVIDERS = catena di fallback (il primo
# che risponde vince); se tutti falliscono si ripiega sulle parole-chiave. WEB_INTENT_ENABLED=0
# disattiva del tutto il classificatore (solo parole-chiave).
WEB_INTENT_ENABLED=1
WEB_INTENT_PROVIDERS=deepseek,cerebras
WEB_INTENT_TIMEOUT=8

# Consolidatore AI del Project Brain: a fine sessione un modello veloce estrae dai messaggi
# solo i fatti salienti e riusabili (niente rumore) e li confronta col gia' noto
# (new/duplicate/conflict/refine). Gira UNA volta per archiviazione, non per messaggio.
# Catena di fallback (il primo che risponde vince); se falliscono si ripiega sulle
# parole-chiave. BRAIN_CONSOLIDATION_ENABLED=0 -> solo parole-chiave (vecchio comportamento).
BRAIN_CONSOLIDATION_ENABLED=1
BRAIN_CONSOLIDATION_PROVIDERS=deepseek,cerebras
BRAIN_CONSOLIDATION_TIMEOUT=25
BRAIN_CONSOLIDATION_MAX_MESSAGES=60

# Promozione a "residente": i fatti del brain con confidenza >= MIN_CONFIDENCE rientrano
# SEMPRE nel contesto dell'AI, a prescindere dalle parole del messaggio (come la Knowledge
# residente). MAX_ITEMS limita quanti iniettarne per non gonfiare il contesto.
# BRAIN_RESIDENT_ENABLED=0 -> torna al solo recupero per keyword.
BRAIN_RESIDENT_ENABLED=1
BRAIN_RESIDENT_MIN_CONFIDENCE=0.75
BRAIN_RESIDENT_MAX_ITEMS=12

# Generazione immagini: catena di fallback cloudflare->gemini. Cloudflare Workers AI richiede
# account id e token con permesso Workers AI; Gemini riusa GOOGLE_API_KEY. Verifica prezzi, quote e
# requisiti di billing sui siti ufficiali prima dell'uso.
IMAGE_GEN_ENABLED=1
IMAGE_GEN_PROVIDERS=cloudflare,gemini
IMAGE_GEN_TIMEOUT=60
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Agnes AI (https://agnes-ai.com/).
AGNES_API_KEY=
AGNES_DEFAULT_MODEL=agnes-2.0-flash
